pipeline {
    agent any

    environment {
        IMAGE_NAME = "gitea.fil-lost.org/mess9/fillost"
        IMAGE_TAG = "${env.BUILD_NUMBER}"
        COMPOSE_DIR = "/home/mess9/services/docker/fillost"
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build image') {
            steps {
                sh """
                    docker build \
                      -f deploy/docker/Dockerfile \
                      -t $IMAGE_NAME:$IMAGE_TAG \
                      -t $IMAGE_NAME:latest \
                      .
                """
            }
        }

        stage('Push image') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'gitea-registry',
                    usernameVariable: 'REGISTRY_USER',
                    passwordVariable: 'REGISTRY_PASSWORD'
                )]) {
                    sh """
                        echo "$REGISTRY_PASSWORD" | docker login gitea.fil-lost.org -u "$REGISTRY_USER" --password-stdin
                        docker push $IMAGE_NAME:$IMAGE_TAG
                        docker push $IMAGE_NAME:latest
                    """
                }
            }
        }

        stage('Deploy') {
            steps {
                sh """
                    mkdir -p $COMPOSE_DIR
                    cp deploy/docker/compose.yaml $COMPOSE_DIR/compose.yaml

                    cd $COMPOSE_DIR
                    docker compose pull
                    docker compose up -d
                """
            }
        }
    }
}