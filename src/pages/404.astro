---
import ThemeToggle from "../components/ThemeToggle.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

const description = "страница не найдена на fil-lost.org.";
---

<BaseLayout title="404 | fil-lost.org" description={description} pathname="/404" noindex={true}>
  <Fragment slot="header-actions">
    <ThemeToggle />
  </Fragment>

  <main id="content" class="not-found">
    <section class="panel not-found__card">
      <p class="not-found__code">404 / route lost</p>
      <h1 class="not-found__title">страница не обнаружена</h1>
      <p class="not-found__text">
        если тут что-то было, а теперь нет - это печально, нужно обязательно сообщить о том кому следует
      </p>
      <p>
        сообщять сюда - <a href="https://t.me/mess9">жмав!</a>
      </p>
      <p>
        я серъёзно. напишите пожалуйста, иначе оно никогда не будет исправлено :(
      </p>
      <a class="back-link" href="/">вернуться на главную</a>
    </section>
  </main>
</BaseLayout>
