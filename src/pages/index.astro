---
import { getEntry, render } from "astro:content";
import ThemeToggle from "../components/ThemeToggle.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { SITE_URL } from "../lib/site";

const home = await getEntry("pages", "home");

if (!home) {
  throw new Error("Missing src/content/pages/home.mdx entry.");
}

const { Content } = await render(home);
const { data } = home;
const sameAsLinks = data.contacts.filter((item) => item.href.startsWith("http")).map((item) => item.href);
const visibleAliases = [...new Set([data.title, ...data.searchAliases])];
const alternateNames = [...new Set([data.title, ...data.searchAliases, "Fil Lost", "Фил Лост"])];

const structuredData = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: data.title,
  alternateName: alternateNames,
  url: SITE_URL,
  description: data.seo.description,
  knowsAbout: [
    "java backend",
    "qa automation",
    "backend testing",
    "test automation",
    "homelab",
    "self-hosted services",
    "guitar",
    "heavy music",
    "cruiser motorcycles"
  ],
  sameAs: sameAsLinks,
  homeLocation: {
    "@type": "Place",
    name: "Alaverdi, Armenia"
  },
  mainEntityOfPage: SITE_URL
};
---

<BaseLayout
  title={data.seo.title}
  description={data.seo.description}
  pathname="/"
  image={data.seo.ogImage}
  keywords={data.searchAliases}
  structuredData={structuredData}
>
  <Fragment slot="header-actions">
    <ThemeToggle />
  </Fragment>

  <main id="content">
    <section class="hero">
      <div class="panel hero-main">
        <p class="eyebrow">fil-lost.org / personal page</p>
        <h1 class="hero-title">{data.title}</h1>
        <p class="hero-subtitle">{data.identity}</p>

        <div class="hero-copy">
          {data.intro.map((paragraph) => (
            <p>{paragraph}</p>
          ))}
        </div>

        <div class="pill-row" aria-label="search aliases">
          {visibleAliases.map((alias) => (
            <span class="pill">{alias}</span>
          ))}
        </div>
      </div>

      <aside class="panel hero-aside" aria-label="quick profile">
        <h2 class="aside-heading">коротко о себе</h2>
        <div class="metric-list">
          {data.quickFacts.map((fact) => (
            <div class="metric">
              <strong>{fact.label}</strong>
              <span>{fact.value}</span>
            </div>
          ))}
        </div>
      </aside>
    </section>

    <section class="panel section" aria-labelledby="work">
      <div class="section-header">
        <h2 class="section-heading" id="work">что у меня по работе</h2>
        <span class="section-note">коротко, без корпоративного тона</span>
      </div>
      <div class="card-grid">
        {data.workCards.map((area) => (
          <article class="info-card">
            <h3>{area.title}</h3>
            <p>{area.text}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="panel section" aria-labelledby="life">
      <div class="section-header">
        <h2 class="section-heading" id="life">что есть кроме работы</h2>
        <span class="section-note">чтобы страница была про человека, а не только про стек</span>
      </div>
      <div class="card-grid">
        {data.lifeCards.map((item) => (
          <article class="info-card">
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="panel section" aria-labelledby="notes">
      <div class="section-header">
        <h2 class="section-heading" id="notes">что дальше</h2>
        <span class="section-note">эта штука будет понемногу жить и дополняться</span>
      </div>
      <article class="prose">
        <Content />
      </article>
    </section>

    <section class="panel section" aria-labelledby="contacts">
      <div class="section-header">
        <h2 class="section-heading" id="contacts">контакты</h2>
        <span class="section-note">linkedin, github, telegram. почту добавлю позже.</span>
      </div>
      <div class="contact-grid">
        {data.contacts.map((contact) => {
          const external = contact.href.startsWith("http");

          return (
            <a
              class="contact-card"
              href={contact.href}
              target={external ? "_blank" : undefined}
              rel={external ? "me noopener noreferrer" : undefined}
            >
              <span class="contact-label">{contact.label}</span>
              <span class="contact-value">{contact.value}</span>
              {contact.note && <span class="contact-note">{contact.note}</span>}
            </a>
          );
        })}
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <p>fil-lost.org, личная страница, которая будет меняться вместе с жизнью.</p>
  </footer>
</BaseLayout>
